{
  "welcome": {
    "message": "Tree cover loss from Hansen Global Forest Change, queried in your browser. The Settings panel above the layers sets the years, the region and the unit; the charts and the hex layer re-run when you change them."
  },
  "plugins": [
    {
      "url": "core/plugins/mcp.js",
      "options": {
        "servers": [
          {
            "worker": "geo-query-worker.js",
            "worker_config": {
              "discovery": false
            },
            "include": [
              "query",
              "register_hex_tiles",
              "get_hex_tile_status"
            ]
          }
        ]
      }
    },
    {
      "url": "core/plugins/controls.js",
      "options": {
        "controls": [
          {
            "id": "compare",
            "label": "Compare",
            "token": "COMPARE",
            "control": "segmented",
            "options": [
              {
                "value": "one",
                "label": "One region by year"
              },
              {
                "value": "all",
                "label": "All regions"
              }
            ]
          },
          {
            "id": "region",
            "label": "Region (one H3 resolution-0 cell)",
            "token": "REGION",
            "control": "select",
            "when": {
              "compare": "one"
            },
            "options": [
              {
                "value": "west-africa",
                "label": "West Africa",
                "tokens": {
                  "H0": "578536630256664575"
                }
              },
              {
                "value": "southern-amazon",
                "label": "Southern Amazon",
                "tokens": {
                  "H0": "578923658349641727"
                }
              },
              {
                "value": "western-amazon",
                "label": "Western Amazon",
                "tokens": {
                  "H0": "578994027093819391"
                }
              },
              {
                "value": "borneo",
                "label": "Borneo",
                "tokens": {
                  "H0": "578325524024131583"
                }
              }
            ]
          },
          {
            "id": "years",
            "label": "Loss years",
            "token": "YEAR",
            "control": "range",
            "options": [
              2001,
              2002,
              2003,
              2004,
              2005,
              2006,
              2007,
              2008,
              2009,
              2010,
              2011,
              2012,
              2013,
              2014,
              2015,
              2016,
              2017,
              2018,
              2019,
              2020,
              2021,
              2022,
              2023,
              2024,
              2025
            ],
            "default": [
              2011,
              2025
            ]
          },
          {
            "id": "unit",
            "label": "Unit",
            "token": "UNIT",
            "control": "segmented",
            "options": [
              {
                "value": "km2",
                "label": "km²",
                "tokens": {
                  "SCALE": "1",
                  "UNIT_LABEL": "km²"
                }
              },
              {
                "value": "kha",
                "label": "Thousand ha",
                "tokens": {
                  "SCALE": "0.1",
                  "UNIT_LABEL": "thousand ha"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "url": "core/plugins/hex.js",
      "options": {
        "layers": [
          {
            "layer_id": "loss",
            "display_name": "Tree cover loss",
            "when": {
              "compare": "one"
            },
            "agg": "SUM",
            "value_column": "loss",
            "palette": "ylorrd",
            "sql": "SELECT h3_cell_to_parent(h8::UBIGINT, 6) AS h6, SUM(frac * h3_cell_area(h8::UBIGINT, 'km^2')) * {{SCALE}} AS loss FROM read_parquet('s3://public-forest-change/tree-cover-loss/loss-year/hex/h0=*/data_0.parquet', hive_partitioning = true) WHERE h0 = {{H0}} AND loss_year BETWEEN {{YEAR_MIN}} - 2000 AND {{YEAR_MAX}} - 2000 GROUP BY 1"
          }
        ]
      }
    },
    {
      "url": "core/plugins/charts.js",
      "options": {
        "charts": [
          {
            "chart_id": "loss-by-year",
            "chart_type": "bar",
            "title": "Tree cover loss by year ({{UNIT_LABEL}})",
            "x": "year",
            "y": "loss",
            "y_label": "Loss ({{UNIT_LABEL}})",
            "when": {
              "compare": "one"
            },
            "sql": "SELECT 2000 + loss_year AS year, SUM(frac * h3_cell_area(h8::UBIGINT, 'km^2')) * {{SCALE}} AS loss FROM read_parquet('s3://public-forest-change/tree-cover-loss/loss-year/hex/h0=*/data_0.parquet', hive_partitioning = true) WHERE h0 = {{H0}} AND loss_year BETWEEN {{YEAR_MIN}} - 2000 AND {{YEAR_MAX}} - 2000 GROUP BY loss_year ORDER BY year"
          },
          {
            "chart_id": "loss-by-region",
            "chart_type": "bar",
            "title": "Tree cover loss, {{YEAR_MIN}} to {{YEAR_MAX}} ({{UNIT_LABEL}})",
            "x": "region",
            "y": "loss",
            "y_label": "Loss ({{UNIT_LABEL}})",
            "when": {
              "compare": "all"
            },
            "sql": "SELECT CASE h0 WHEN 578536630256664575 THEN 'West Africa' WHEN 578923658349641727 THEN 'Southern Amazon' WHEN 578994027093819391 THEN 'Western Amazon' WHEN 578325524024131583 THEN 'Borneo' END AS region, SUM(frac * h3_cell_area(h8::UBIGINT, 'km^2')) * {{SCALE}} AS loss FROM read_parquet('s3://public-forest-change/tree-cover-loss/loss-year/hex/h0=*/data_0.parquet', hive_partitioning = true) WHERE h0 IN (578536630256664575, 578923658349641727, 578994027093819391, 578325524024131583) AND loss_year BETWEEN {{YEAR_MIN}} - 2000 AND {{YEAR_MAX}} - 2000 GROUP BY ALL ORDER BY loss DESC"
          }
        ]
      }
    }
  ]
}
