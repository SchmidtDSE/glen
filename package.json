{
  "name": "glen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.include='app/**' --coverage.include='core/**'",
    "build:vendor": "esbuild scripts/hyparquet-entry.js --bundle --format=esm --platform=browser --minify --legal-comments=eof --outfile=app/vendor/hyparquet.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "0.28.2",
    "hyparquet": "1.32.0",
    "jsdom": "26.1.0",
    "vitepress": "^1.6.3",
    "vitest": "^2.1.9"
  }
}
